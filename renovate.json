{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "fetchChangeLogs": "off",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "prBodyColumns": ["Package", "Update", "Change"],
  "prCreation": "immediate",
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "5 day"
    },
    {
      "matchDatasources": ["npm"],
      "matchDepNames": ["renovate"],
      "schedule": ["* * * * 0"]
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentAge": "> 5 days",
      "automerge": true
    },
    {
      "matchFileNames": ["benchmark/real_world/schemas/**/source.json"],
      "groupName": "real-world schemas",
      "semanticCommitType": "test",
      "automerge": false,
      "schedule": ["* * * * 1"]
    }
  ],
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^benchmark/real_world/schemas/[^/]+/source\\.json$/"],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"\\s]+)\",\\s*\"branch\":\\s*\"(?<currentValue>[^\"\\s]+)\",\\s*\"revision\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "versioningTemplate": "exact"
    }
  ]
}
