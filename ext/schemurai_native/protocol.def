/* Shared C/Rust/Ruby native protocol. Keep wire values stable. */
SN_OPCODE(BOOLEAN, boolean, 0)
SN_OPCODE(TYPE_NULL, type_null, 1)
SN_OPCODE(TYPE_BOOLEAN, type_boolean, 2)
SN_OPCODE(TYPE_OBJECT, type_object, 3)
SN_OPCODE(TYPE_ARRAY, type_array, 4)
SN_OPCODE(TYPE_NUMBER, type_number, 5)
SN_OPCODE(TYPE_INTEGER, type_integer, 6)
SN_OPCODE(TYPE_STRING, type_string, 7)
SN_OPCODE(TYPES, types, 8)
SN_OPCODE(CONST, const, 9)
SN_OPCODE(ENUM, enum, 10)
SN_OPCODE(ALL_OF, allOf, 11)
SN_OPCODE(ANY_OF, anyOf, 12)
SN_OPCODE(ONE_OF, oneOf, 13)
SN_OPCODE(NOT, not, 14)
SN_OPCODE(CONDITIONAL, conditional, 15)
SN_OPCODE(NUMBER, number, 16)
SN_OPCODE(TYPED_NUMBER, typed_number, 17)
SN_OPCODE(TYPED_INTEGER, typed_integer, 18)
SN_OPCODE(STRING, string, 19)
SN_OPCODE(TYPED_STRING, typed_string, 20)
SN_OPCODE(ARRAY, array, 21)
SN_OPCODE(TYPED_ARRAY, typed_array, 22)
SN_OPCODE(OBJECT, object, 23)
SN_OPCODE(TYPED_OBJECT, typed_object, 24)
SN_OPCODE(REF, ref, 25)
SN_OPCODE(RECURSIVE_REF, recursive_ref, 26)
SN_OPCODE(DYNAMIC_REF, dynamic_ref, 27)

/* Match VM::TypeRules and VM::NumberRules bit masks. */
SN_CONSTANT(TYPE_NULL, 1)
SN_CONSTANT(TYPE_BOOLEAN, 2)
SN_CONSTANT(TYPE_OBJECT, 4)
SN_CONSTANT(TYPE_ARRAY, 8)
SN_CONSTANT(TYPE_NUMBER, 16)
SN_CONSTANT(TYPE_INTEGER, 32)
SN_CONSTANT(TYPE_STRING, 64)
SN_CONSTANT(TYPE_INTEGRAL_NUMBER, 48)
SN_CONSTANT(TYPE_UNSUPPORTED, 128)
/* Native-only scalar kind outside the JSON type masks. */
SN_CONSTANT(TYPE_IDENTITY_SCALAR, 256)
SN_CONSTANT(MAXIMUM, 1)
SN_CONSTANT(MINIMUM, 2)
SN_CONSTANT(EXCLUSIVE_MAXIMUM, 4)
SN_CONSTANT(EXCLUSIVE_MINIMUM, 8)
SN_CONSTANT(MULTIPLE_OF, 16)
SN_CONSTANT(TRACKS_EVALUATION, 1)
SN_CONSTANT(TRACKS_DYNAMIC_SCOPE, 2)

/* Adapter results; comparison/packing reserves 3 beyond ordinary -2..2. */
SN_CONSTANT(VERDICT_INVALID, 0)
SN_CONSTANT(VERDICT_VALID, 1)
SN_CONSTANT(VERDICT_UNSUPPORTED, 2)
SN_CONSTANT(REGEXP_INVALID, 3)

/* Runtime requests handled by C only after Rust evaluation returns. */
SN_CONSTANT(RUNTIME_REGEXP_STRICT, 0)
SN_CONSTANT(RUNTIME_REGEXP_ASSERTION, 1)
SN_CONSTANT(RUNTIME_JSON, 2)
SN_CONSTANT(RUNTIME_POINTER, 3)
SN_CONSTANT(RUNTIME_IDENTITY_METHODS, 4)
SN_CONSTANT(RUNTIME_REQUIRED_MISSING, 5)
SN_CONSTANT(RUNTIME_DIAGNOSTIC_MESSAGE, 6)
SN_CONSTANT(RUNTIME_SCALAR_CONTAINS, 7)
/* Null numeric requests add twice the assertion bit and the decimal-mode bit. */
SN_CONSTANT(RUNTIME_NULL_NUMBER, 8)
SN_CONSTANT(RUNTIME_OBJECT_REPORT, 55)
SN_CONSTANT(RUNTIME_PROPERTY_MERGE, 56)
SN_CONSTANT(RUNTIME_PATH_POP, 57)
SN_CONSTANT(RUNTIME_ARRAY_REPORT, 58)
SN_CONSTANT(RUNTIME_NATIVE_REPORT, 59)
SN_CONSTANT(RUNTIME_NATIVE_CHILD, 60)
SN_CONSTANT(RUNTIME_OBJECT_CHILDREN, 61)
SN_CONSTANT(RUNTIME_ARRAY_CHILDREN, 62)
SN_CONSTANT(RUNTIME_CALLBACK_CHECKPOINT, 63)
/* Type requests add twice the type mask and the union-opcode bit. */
SN_CONSTANT(RUNTIME_TYPE, 64)
/* Numeric frame requests add 64 times the step and the required type mask. */
SN_CONSTANT(RUNTIME_NUMBER, 1024)
/* String frames add 256 times the step, required type and option flags. */
SN_CONSTANT(RUNTIME_STRING, 2048)
/* Occurrence-based Ruby value primitives, without schema evaluation. */
SN_CONSTANT(RUNTIME_EQUAL, 8192)
SN_CONSTANT(RUNTIME_ENUM, 8193)
SN_CONSTANT(RUNTIME_UNIQUE, 8194)
/* Container header frames add 64 times the step and required type mask. */
SN_CONSTANT(RUNTIME_ARRAY_HEADER, 16384)
SN_CONSTANT(RUNTIME_OBJECT_HEADER, 32768)
SN_CONSTANT(ADAPTER_UNSUPPORTED, 3)
SN_CONSTANT(STATUS_PANIC, -1)
SN_CONSTANT(STATUS_EXCEPTION, -2)
SN_CONSTANT(STATUS_STACK_ERROR, -3)
SN_CONSTANT(STATUS_DECIMAL_NAN, -4)
SN_CONSTANT(STATUS_DECIMAL_POSITIVE_INFINITY, -5)
SN_CONSTANT(STATUS_DECIMAL_NEGATIVE_INFINITY, -6)
SN_CONSTANT(OPCODE_UNKNOWN, -1)
SN_CONSTANT(SMALL_HASH_ORDINARY, 16)
SN_CONSTANT(SMALL_HASH_COUNT_MASK, 15)
SN_CONSTANT(SMALL_HASH_TOO_LARGE, -2)
SN_CONSTANT(ENCODING_OTHER, 0)
SN_CONSTANT(ENCODING_UTF8, 1)
SN_CONSTANT(ENCODING_ASCII, 2)
SN_CONSTANT(ENCODING_SEVEN_BIT, 3)

SN_CONSTANT(CALLBACK_RUNTIME, 0)
SN_CONSTANT(CALLBACK_BOOLEAN, 1)
SN_CONSTANT(CALLBACK_TYPE, 2)

/* Fixed native constructor accessors; IDs are initialized before Ractor use. */
SN_FIELD(ADDITIONAL, "additional", 0)
SN_FIELD(CODE, "code", 1)
SN_FIELD(CONDITION, "condition", 2)
SN_FIELD(CONTAINS, "contains", 3)
SN_FIELD(COUNT_CONTAINS, "count_contains", 4)
SN_FIELD(DENOMINATOR, "denominator", 5)
SN_FIELD(DEPENDENCIES, "dependencies", 6)
SN_FIELD(DEPENDENT_REQUIRED, "dependent_required", 7)
SN_FIELD(DEPENDENT_SCHEMAS, "dependent_schemas", 8)
SN_FIELD(DYNAMIC_ANCHOR, "dynamic_anchor", 9)
SN_FIELD(ELSE_BRANCH, "else_branch", 10)
SN_FIELD(EXCLUSIVE_MAXIMUM, "exclusive_maximum", 11)
SN_FIELD(EXCLUSIVE_MINIMUM, "exclusive_minimum", 12)
SN_FIELD(FORMAT, "format", 13)
SN_FIELD(FORMAT_ASSERTION, "format_assertion", 14)
SN_FIELD(FRAGMENT, "fragment", 15)
SN_FIELD(ITEMS, "items", 16)
SN_FIELD(ITEMS_LIST, "items_list", 17)
SN_FIELD(MASK, "mask", 18)
SN_FIELD(MAX_CONTAINS, "max_contains", 19)
SN_FIELD(MAX_ITEMS, "max_items", 20)
SN_FIELD(MAX_LENGTH, "max_length", 21)
SN_FIELD(MAX_PROPERTIES, "max_properties", 22)
SN_FIELD(MAXIMUM, "maximum", 23)
SN_FIELD(MESSAGE, "message", 24)
SN_FIELD(MIN_CONTAINS, "min_contains", 25)
SN_FIELD(MIN_ITEMS, "min_items", 26)
SN_FIELD(MIN_LENGTH, "min_length", 27)
SN_FIELD(MIN_PROPERTIES, "min_properties", 28)
SN_FIELD(MINIMUM, "minimum", 29)
SN_FIELD(MULTIPLE_OF, "multiple_of", 30)
SN_FIELD(NAME, "name", 31)
SN_FIELD(NEGATIVE_P, "negative?", 32)
SN_FIELD(NODE, "node", 33)
SN_FIELD(NUMERATOR, "numerator", 34)
SN_FIELD(PARSE_JSON, "parse_json", 35)
SN_FIELD(PATTERN, "pattern", 36)
SN_FIELD(PATTERNS, "patterns", 37)
SN_FIELD(PREFIX_ITEMS, "prefix_items", 38)
SN_FIELD(PROPERTIES, "properties", 39)
SN_FIELD(PROPERTY_NAMES, "property_names", 40)
SN_FIELD(RECURSIVE_ANCHOR_P, "recursive_anchor?", 41)
SN_FIELD(REQUIRED, "required", 42)
SN_FIELD(RESOURCE, "resource", 43)
SN_FIELD(THEN_BRANCH, "then_branch", 44)
SN_FIELD(TO_F, "to_f", 45)
SN_FIELD(UNEVALUATED, "unevaluated", 46)
SN_FIELD(UNIQUE, "unique", 47)
SN_FIELD(VALUE, "value", 48)
SN_FIELD(DECODE_BASE64, "decode_base64", 49)
