module Schemurai
  # A JSON-shaped Ruby value accepted as a schema value or validation instance.
  type json_value = nil | bool | Integer | Float | String | Array[json_value] | Hash[String, json_value]

  # A JSON Schema root.
  type schema = bool | Hash[String, json_value]

  # External schemas indexed by their absolute URI.
  type schemas = Hash[String, schema]

  # A resolved evaluator backend.
  type backend = :ruby | :vm | :native

  # A backend accepted when configuring a validator.
  type backend_selection = backend | :default

  VERSION: String

  class Error < StandardError
  end

  class LimitExceeded < Error
    attr_reader limit: Symbol
    attr_reader maximum: Integer | Float
    attr_reader attempted: Integer | Float

    def initialize: (Symbol limit, Integer | Float maximum, Integer | Float attempted) -> void
  end

  class ResolutionError < Error
  end

  class UnsupportedFormatError < Error
  end

  class InvalidSchemaError < Error
    attr_reader result: Result

    def initialize: (Result result) -> void
  end

  class ValidationError < Data
    attr_reader keyword: String
    attr_reader instance_path: String
    attr_reader schema_path: String
    attr_reader message: String

    def self.new: (String keyword, String instance_path, String schema_path, String message) -> ValidationError
                | (keyword: String, instance_path: String, schema_path: String, message: String) -> ValidationError

    def self.[]: (String keyword, String instance_path, String schema_path, String message) -> ValidationError
               | (keyword: String, instance_path: String, schema_path: String, message: String) -> ValidationError

    def to_h: () -> { keyword: String, instance_path: String, schema_path: String, message: String }
  end

  class Result
    attr_reader errors: Array[ValidationError]

    def initialize: (Array[ValidationError] errors) -> void
    def valid?: () -> bool
    alias success? valid?
  end

  interface _Evaluator
    def backend: () -> backend

    def validate: (json_value instance) -> Result

    def valid?: (json_value instance) -> bool
  end

  class Validator
    def initialize: (_Evaluator evaluator, ?max_errors: Integer?, ?timeout: (Integer | Float)?, ?bounded_evaluator: (^() -> untyped)?) -> void
    def backend: () -> backend
    def validate: (json_value instance, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Result
    def valid?: (json_value instance, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> bool
  end

  class SchemaRegistry
    attr_reader backend: backend

    def initialize: (?schemas: schemas, ?validate_schema: bool, ?backend: backend_selection) -> void

    def validate_schema?: () -> bool

    def compile: (schema schema, ?base_uri: String?, ?content: bool, ?format: bool, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Validator

    def validate_schema: (schema schema, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Result
    def valid_schema?: (schema schema, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> bool
    def make_shareable: () -> self
    def shareable?: () -> bool

    def validator_for: (String uri, ?content: bool, ?format: bool, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Validator
  end

  def self.backend: () -> backend

  def self.compile: (schema schema, ?schemas: schemas, ?base_uri: String?, ?content: bool, ?format: bool, ?validate_schema: bool, ?backend: backend_selection, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Validator

  def self.validate_schema: (schema schema, ?schemas: schemas, ?backend: backend_selection, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Result

  def self.valid_schema?: (schema schema, ?schemas: schemas, ?backend: backend_selection, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> bool

  def self.validate: (schema schema, json_value instance, ?schemas: schemas, ?base_uri: String?, ?content: bool, ?format: bool, ?validate_schema: bool, ?backend: backend_selection, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> Result

  def self.valid?: (schema schema, json_value instance, ?schemas: schemas, ?base_uri: String?, ?content: bool, ?format: bool, ?validate_schema: bool, ?backend: backend_selection, ?max_errors: Integer?, ?timeout: (Integer | Float)?) -> bool
end
